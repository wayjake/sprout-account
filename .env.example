# OpenRouter — used for PDF statement extraction, CSV column mapping, and AI categorization.
# Optional: without a key everything works except PDF import (CSV mapping falls back
# to a header-name heuristic, categorization uses merchant memory only).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL_PDF=google/gemini-2.5-flash

# Local SQLite database file
DATABASE_PATH=./data/finance.db
