{
  "name": "sprout-account",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "bun --bun --conditions=development ./node_modules/@react-router/dev/bin.cjs dev",
    "start": "bun --bun react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "bun scripts/seed.ts",
    "test:extraction": "bun scripts/test-extraction.ts",
    "desktop:build": "react-router build && bun scripts/desktop/build.ts && tauri build"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.36",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^22",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
